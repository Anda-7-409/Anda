
# 复制本文件为 .env 并填写真实值；不填也能跑，邮件会降级为"开发模式链接"

# QQ邮箱SMTP授权码（≠QQ登录密码）：QQ邮箱网页版 → 设置 → 账户 → 开启SMTP服务 → 生成授权码
QQ_EMAIL_USER=
QQ_EMAIL_AUTH_CODE=

# 生成邮件链接的对外地址（公网入口，可走 Cloudflare 隧道）
FRONTEND_BASE_URL=

GLM_API_KEY=
GLM_MODEL_TOOL=glm-4.7-flash
GLM_MODEL_AGAIN=glm-4-flash
GLM_ADDITIONAL_MODEL=glm-4-flash-250414
GLM_MODEL_PICTURE_UNDERSTAND=glm-4.6V-flash
GLM_MODEL_PICTURE_PRODUCT=CogView-3-flash

LOCAL_OLLAMA_MODEL=mimo9b:latest

QIANFAN_AI_SEARCH_KEY=
ANY_SEARCH_KEY=

SILICONFLOW_API_KEY=
# 高德地图开放平台"Web服务"类型Key（MCP Server 与 REST 兑底共用）：lbs.amap.com → 应用管理 → 创建Key
AMAP_MAPS_API_KEY=

# MinerU 文档解析 Token（mineru.net → API管理 → 创建）；不填也能用免登录轻量解析（限10MB/20页）
MINERU_API_KEY=
