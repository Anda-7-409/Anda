# 复制本文件为 .env 并填写真实值；不填也能跑，邮件会降级为"开发模式链接"

# QQ邮箱SMTP授权码（≠QQ登录密码）：QQ邮箱网页版 → 设置 → 账户 → 开启SMTP服务 → 生成授权码
QQ_EMAIL_USER=your@qq.com
QQ_EMAIL_AUTH_CODE=

# 生成邮件链接的对外地址（公网入口；本地调试可临时改回 http://localhost:5173）
FRONTEND_BASE_URL=http://localhost:5173   # 可以填写自己的公网地址

# —— AI 模型（留空也能跑：对话降级为“演示模式”回复）——
# 云端GLM：智谱开放平台 https://open.bigmodel.cn → API密钥管理（新用户送免费额度）
GLM_API_KEY=
GLM_MODEL=glm-4-flash
# 本地Ollama：官网安装后执行 ollama pull qwen2.5（无需Key）
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
